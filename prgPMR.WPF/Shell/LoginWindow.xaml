<Window x:Class="prgPMR.WPF.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Medical Records — Login"
        Height="340" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F6FA">
        <StackPanel VerticalAlignment="Center" Margin="50,0">

            <!-- Title -->
            <TextBlock Text="Personal Medical Records"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Error banner -->
            <Border Background="#FDECEA" CornerRadius="4" Padding="10,6"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" TextWrapping="Wrap"/>
            </Border>

            <!-- Username -->
            <TextBlock Text="Username" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" FontSize="14"
                     Padding="8,0" Margin="0,0,0,12"
                     VerticalContentAlignment="Center"/>

            <!-- Password -->
            <TextBlock Text="Password" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="36" FontSize="14"
                         Padding="8,0" Margin="0,0,0,24"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Login"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource ActionButton}"
                        Margin="0,0,6,0"/>

                <Button Grid.Column="1" Content="Exit"
                        Command="{Binding ExitCommand}"
                        Style="{StaticResource DangerButton}"
                        Margin="6,0,0,0"/>
            </Grid>

        </StackPanel>

        <!-- Loading overlay -->
        <Grid Background="#80FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Logging in…" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="16"/>
        </Grid>
    </Grid>
</Window>
