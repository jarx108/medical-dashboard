<Window x:Class="prgPMR.WPF.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Medical Records"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Body -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#2C3E50">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Patient info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="White"
                               Text="Personal Medical Records" Margin="0,0,24,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Patient:" Foreground="#BDC3C7" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding PatientName}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DOB:" Foreground="#BDC3C7" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding PatientDob}" Foreground="White" FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <!-- Logout -->
                <Button Grid.Column="1" Content="Logout"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource ActionButton}"
                        Background="#E74C3C"/>
            </Grid>
        </Border>

        <!-- ══ BODY ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175"/>   <!-- Left nav -->
                <ColumnDefinition Width="*"/>     <!-- Content area -->
            </Grid.ColumnDefinitions>

            <!-- ── Left navigation panel ──────────────────────────────────── -->
            <Border Grid.Column="0" Background="#34495E">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12">
                        <Button Content="Immunizations"
                                Command="{Binding NavigateToImmunizationCommand}"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="Medications"
                                Command="{Binding NavigateToMedicationsCommand}"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="Family History"
                                Command="{Binding NavigateToFamilyHistoryCommand}"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="Doctor Visits"
                                Command="{Binding NavigateToDoctorVisitsCommand}"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="Medical Tests"
                                Command="{Binding NavigateToTestsCommand}"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="Bloodwork"
                                Command="{Binding NavigateToBloodworkCommand}"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="Surgeries"
                                Command="{Binding NavigateToSurgeriesCommand}"
                                Style="{StaticResource NavButton}"/>
                        <Button Content="Hospitalizations"
                                Command="{Binding NavigateToHospitalizationsCommand}"
                                Style="{StaticResource NavButton}"/>

                        <Separator Margin="4,12" Background="#4A6278"/>

                        <Button Content="My Information"
                                Command="{Binding NavigateToUpdateUserInfoCommand}"
                                Style="{StaticResource NavButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Content area — renders the active module's View ─────────── -->
            <!-- WPF DataTemplates (defined in App.xaml) map ViewModel type → View.
                 No code needed here — just bind CurrentViewModel. -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}"
                            Background="White"/>
        </Grid>
    </Grid>
</Window>
