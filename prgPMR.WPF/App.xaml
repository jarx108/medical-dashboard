<Application x:Class="prgPMR.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:prgPMR.WPF.Infrastructure.Converters"
             xmlns:shell="clr-namespace:prgPMR.WPF.Shell"
             xmlns:imm="clr-namespace:prgPMR.WPF.Modules.Immunization"
             xmlns:med="clr-namespace:prgPMR.WPF.Modules.Medications"
             xmlns:fam="clr-namespace:prgPMR.WPF.Modules.FamilyHistory"
             xmlns:dv="clr-namespace:prgPMR.WPF.Modules.DoctorVisits"
             xmlns:tst="clr-namespace:prgPMR.WPF.Modules.Tests"
             xmlns:bw="clr-namespace:prgPMR.WPF.Modules.Bloodwork"
             xmlns:surg="clr-namespace:prgPMR.WPF.Modules.Surgeries"
             xmlns:hosp="clr-namespace:prgPMR.WPF.Modules.Hospitalizations"
             xmlns:upd="clr-namespace:prgPMR.WPF.Modules.UpdateUserInfo">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ── Global converters ──────────────────────────────────────── -->
            <conv:BoolToVisibilityConverter        x:Key="BoolToVis"        />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"     />
            <conv:NullToVisibilityConverter        x:Key="NullToVis"        />
            <conv:DateOnlyConverter                x:Key="DateConv"         />

            <!-- ── DataTemplate mappings: ViewModel → View ───────────────── -->
            <!-- The ContentControl in MainWindow automatically picks the right View
                 when CurrentViewModel changes. No switch statements needed. -->

            <DataTemplate DataType="{x:Type imm:ImmunizationViewModel}">
                <imm:ImmunizationView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type imm:ImmunizationDetailViewModel}">
                <imm:ImmunizationDetailView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type med:MedicationsViewModel}">
                <med:MedicationsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type fam:FamilyHistoryViewModel}">
                <fam:FamilyHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type dv:DoctorVisitsViewModel}">
                <dv:DoctorVisitsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type tst:TestsViewModel}">
                <tst:TestsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type bw:BloodworkViewModel}">
                <bw:BloodworkView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type surg:SurgeriesViewModel}">
                <surg:SurgeriesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type hosp:HospitalizationsViewModel}">
                <hosp:HospitalizationsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type upd:UpdateUserInfoViewModel}">
                <upd:UpdateUserInfoView />
            </DataTemplate>

            <!-- ── Global styles ──────────────────────────────────────────── -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Height"           Value="48"/>
                <Setter Property="Margin"           Value="4,2"/>
                <Setter Property="FontSize"         Value="13"/>
                <Setter Property="Background"       Value="#2C3E50"/>
                <Setter Property="Foreground"       Value="White"/>
                <Setter Property="BorderThickness"  Value="0"/>
                <Setter Property="Cursor"           Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D5166"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1A252F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Height"          Value="34"/>
                <Setter Property="MinWidth"        Value="80"/>
                <Setter Property="Padding"         Value="16,0"/>
                <Setter Property="Margin"          Value="4,0"/>
                <Setter Property="FontSize"        Value="13"/>
                <Setter Property="Background"      Value="#2980B9"/>
                <Setter Property="Foreground"      Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDC3C7"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3498DB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#E74C3C"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#C0392B"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
