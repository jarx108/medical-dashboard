<UserControl x:Class="prgPMR.WPF.Modules.Immunization.ImmunizationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title -->
            <RowDefinition Height="Auto"/>  <!-- Error banner -->
            <RowDefinition Height="*"/>     <!-- Form fields -->
            <RowDefinition Height="Auto"/>  <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Add Immunization Record"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                            <Setter Property="Text" Value="Edit Immunization Record"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Error banner -->
        <Border Grid.Row="1" Background="#FDECEA" CornerRadius="4" Padding="10,6"
                Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B"/>
        </Border>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Vaccine Name -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Vaccine Name *"
                           VerticalAlignment="Center" Margin="0,0,8,8" FontWeight="SemiBold"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                           ItemsSource="{Binding VaccineNames}"
                           SelectedItem="{Binding SelectedVaccine}"
                           DisplayMemberPath="DisplayName"
                           Height="32" Margin="0,0,0,8"/>

                <!-- Row 1: Detail Name / Date Given -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Detail Name"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding DetailName, UpdateSourceTrigger=PropertyChanged}"
                           Height="32" Margin="0,0,0,8" Padding="6,0" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="Date Given"
                           VerticalAlignment="Center" Margin="0,0,8,8" FontWeight="SemiBold"/>
                <DatePicker Grid.Row="1" Grid.Column="4"
                            SelectedDate="{Binding DateGivenDateTime}"
                            Height="32" Margin="0,0,0,8"/>

                <!-- Row 2: Facility / Manufacturer -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Facility"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox  Grid.Row="2" Grid.Column="1"
                           ItemsSource="{Binding Facilities}"
                           SelectedItem="{Binding SelectedFacility}"
                           DisplayMemberPath="DisplayName"
                           Height="32" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="Manufacturer"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox  Grid.Row="2" Grid.Column="4"
                           ItemsSource="{Binding Manufacturers}"
                           SelectedItem="{Binding SelectedManufacturer}"
                           DisplayMemberPath="DisplayName"
                           Height="32" Margin="0,0,0,8"/>

                <!-- Row 3: Rx# / NDC# / Lot# -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Rx Number"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding RxNum, UpdateSourceTrigger=PropertyChanged}"
                           Height="32" Margin="0,0,0,8" Padding="6,0" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="3" Text="NDC Number"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox   Grid.Row="3" Grid.Column="4" Text="{Binding NdcNum, UpdateSourceTrigger=PropertyChanged}"
                           Height="32" Margin="0,0,0,8" Padding="6,0" VerticalContentAlignment="Center"/>

                <!-- Row 4: Lot# -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Lot Number"
                           VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding LotNum, UpdateSourceTrigger=PropertyChanged}"
                           Height="32" Margin="0,0,0,8" Padding="6,0" VerticalContentAlignment="Center"/>

                <!-- Row 5+: Notes -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Notes"
                           VerticalAlignment="Top" Margin="0,4,8,8"/>
                <TextBox   Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4"
                           Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                           Height="100" Margin="0,0,0,8"
                           Padding="6,6" AcceptsReturn="True"
                           VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Delete"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource DangerButton}"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Reset"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource ActionButton}"
                    Background="#95A5A6"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ActionButton}"
                    Background="#27AE60"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ActionButton}"
                    Background="#7F8C8D"/>
        </StackPanel>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="4" Background="#80FFFFFF"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Saving…" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="16"/>
        </Grid>
    </Grid>
</UserControl>
